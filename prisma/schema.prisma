// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  price       Float
  old_price   Float?
  image       String?
  images      String[]
  category    String?
  subCategory String?
  brand       String?
  tags        String[]
  stock       Int      @default(0)
  inStock     Boolean  @default(true)
  rating      Float?
  views       Int      @default(0)
  best_seller Boolean  @default(false)
  new_arrival Boolean  @default(false)
  trending    Boolean  @default(false)
  sale        Boolean  @default(false)
  colors      String[]
  video       String?
  discountPercentage Float?
  // إضافة الأبعاد ثلاثية الأبعاد
  width       Float?   // العرض (سم)
  height      Float?   // الارتفاع (سم)
  depth       Float?   // العمق (سم)
  targetGender String? // "male", "female", "kids", "unisex"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
    // Relations
  reviews     Review[]
  productViews ProductView[]
  inspirationProducts InspirationProduct[]
  productInteractions ProductInteraction[]

  @@map("products")
}

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  nameAr      String?
  description String?
  image       String?
  icon        String?
  slug        String   @unique
  parentId    String?  @db.ObjectId
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Category[] @relation("CategoryHierarchy")
  productCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  phone           String   @unique
  email           String?  @unique
  password        String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastLoginAt     DateTime?
  lastIp          String?
  lastUserAgent   String?
  currentSessionId String?
  loginCount      Int      @default(0)
  lastProductViewed Int?
  lastActiveAt    DateTime?
  totalProductViews Int    @default(0)
  totalViewDuration Int    @default(0)
  viewCount       Int      @default(0)
  averageViewDuration Float @default(0)
  orderCount      Int      @default(0)
  lastOrderAt     DateTime?
  reviewCount     Int      @default(0)
  lastReviewAt    DateTime?
    // Relations
  orders          Order[]
  devices         Device[]
  addresses       Address[]
  sessions        Session[]
  preferences     CustomerPreferences?
  notifications   NotificationPreferences?
  reviews         Review[]
  reviewVotes     ReviewVote[]
  productViews    ProductView[]
  events          CustomerEvent[]
  
  // نظام التوصيات المتقدم
  behavior        CustomerBehavior?
  searchHistories SearchHistory[]
  productInteractions ProductInteraction[]
  preferenceProfile CustomerPreferenceProfile?
  recommendationHistories RecommendationHistory[]
  segments        CustomerSegment[]
}

model Device {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId  String   @db.ObjectId
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deviceId    String
  userAgent   String
  ip          String
  lastUsedAt  DateTime @default(now())
}

model Address {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId  String   @db.ObjectId
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title       String
  governorate String
  city        String
  street      String
  building    String
  apartment   String?
  landmark    String?
  isDefault   Boolean  @default(false)
}

model CustomerPreferences {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId        String   @unique @db.ObjectId
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  categories        String[]
  favoriteColors    String[]
  favoriteProducts  Int[]
  recentlyViewed    Int[]
  priceRange        PriceRange?
}

model PriceRange {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  customerPreferencesId String   @unique @db.ObjectId
  customerPreferences   CustomerPreferences @relation(fields: [customerPreferencesId], references: [id], onDelete: Cascade)
  min                   Float
  max                   Float
}

model NotificationPreferences {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId String   @unique @db.ObjectId
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  email      Boolean  @default(true)
  sms        Boolean  @default(true)
  whatsapp   Boolean  @default(true)
  push       Boolean  @default(true)
}

model Order {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId    String?  @db.ObjectId
  customer      Customer? @relation(fields: [customerId], references: [id])
  customerName  String?
  customerPhone String?
  customerEmail String?
  
  // Order details
  items         OrderItem[]
  status        OrderStatus @default(PENDING)
  source        OrderSource @default(WEBSITE)
  
  // Shipping information
  shippingId    String?  @unique @db.ObjectId
  shipping      ShippingInfo?  @relation(fields: [shippingId], references: [id], onDelete: Cascade)
  
  // Payment information
  paymentId     String?  @unique @db.ObjectId
  payment       PaymentInfo?   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  
  // Totals
  totalsId      String?  @unique @db.ObjectId
  totals        OrderTotals?   @relation(fields: [totalsId], references: [id], onDelete: Cascade)
  
  // Promo code
  promoCode     PromoCode?
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  shippedAt     DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?
  
  // Additional info
  trackingNumber String?
  notes         String?
}

model OrderItem {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId      String   @db.ObjectId
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Basic item info
  name         String
  image        String
  price        Float
  quantity     Int
  variant      String?
  discount     Float?
  originalPrice Float?
  
  // Item type and references
  itemType     String   // "product", "inspiration", "custom_gift"
  productId    String?  @db.ObjectId  // for regular products
  inspirationId String? @db.ObjectId  // for ready-made gifts
  
  // Custom gift data (JSON format for flexibility)
  customGiftData Json?  // for custom gifts: {products: [], sweets: [], box: {}, bag: []}
  
  // Gift-specific fields
  giftMessage  String?
  giftRecipient String?
}



model ShippingInfo {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  order        Order?
  governorate  String
  address      String?
  phone        String?
  notes        String?
}

model PaymentInfo {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  order         Order?
  method        PaymentMethod @default(CASH_ON_DELIVERY)
  status        PaymentStatus @default(PENDING)
  transactionId String?
}

model OrderTotals {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  order        Order?
  subtotal     Float
  shippingFees Float
  discount     Float
  tax          Float
  total        Float
}

model PromoCode {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId      String   @unique @db.ObjectId
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  code         String
  discountPercentage Float
}

model Inspiration {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  content     String?  // محتوى مفصل للإلهام
  image       String
  tags        String[] // تاجز للبحث والتصنيف
  rating      Float
  reviews     Int      @default(0)
  likes       Int      @default(0)
  dislikes    Int      @default(0)
  likedBy     String[]
  dislikedBy  String[]
  price       Float
  oldPrice    Float?
  discountPercentage Float?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
    // Relations
  ratings     InspirationRating[]
  comments    InspirationComment[]
  products    InspirationProduct[] @relation("InspirationProducts")
  sweets      InspirationSweet[]
  box         InspirationBoxRelation? @relation("InspirationBoxes")
  bag         InspirationBagRelation? @relation("InspirationBags")
  
}

model InspirationRating {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  inspirationId String  @db.ObjectId
  inspiration   Inspiration @relation(fields: [inspirationId], references: [id], onDelete: Cascade)
  userId       String
  rating       Float
}

model InspirationComment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  inspirationId String  @db.ObjectId
  inspiration   Inspiration @relation(fields: [inspirationId], references: [id], onDelete: Cascade)
  userId       String
  userName     String
  comment      String
  createdAt    DateTime @default(now())
}



model ProductView {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  productId   String   @db.ObjectId
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String   @db.ObjectId
  customer    Customer @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt    DateTime @default(now())
  sessionId   String?
  duration    Int      @default(0)
  source      String
  device      Json?
  interactions Json?
}

model CustomerEvent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  customer    Customer @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType   String
  timestamp   DateTime @default(now())
  context     Json?
  data        Json?
}

model Review {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  productId   String   @db.ObjectId
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String   @db.ObjectId
  customer    Customer @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName    String
  rating      Float
  comment     String?
  helpful     Int      @default(0)
  notHelpful  Int      @default(0)
  verified    Boolean  @default(false)
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  votes       ReviewVote[]
}

model ReviewVote {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  reviewId    String   @db.ObjectId
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId      String   @db.ObjectId
  customer    Customer @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      VoteAction
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([reviewId, userId])
}

model Notification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  message     String
  type        NotificationType
  userId      String?  @db.ObjectId
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model UsedPromoCode {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String
  promoCode    String
  usedAt       DateTime @default(now())
  
  @@unique([userId, promoCode])
  @@map("usedPromoCodes")
}


model Session {
  sessionId     String   @id @map("_id")
  userId        String?  @db.ObjectId
  customer      Customer? @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  lastActiveAt  DateTime @default(now())
  ipAddress     String?
  userAgent     String?
  
  @@map("sessions")
}

model NewsAttachment {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  email           String?
  whatsappNumber  String?
  name            String?
  type            String   // "email" or "whatsapp"
  subscribedAt    DateTime @default(now())
  source          String   // "footer", etc.
  
  @@map("newsAttachment")
  @@unique([email, type])
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?
  action     String
  category   String
  status     String
  details    Json
  ip         String?
  userAgent  String?
  timestamp  DateTime @default(now())
  
  @@map("auditLogs")
}

model SecurityIncident {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?
  action     String
  category   String
  status     String
  details    Json
  ip         String?
  userAgent  String?
  timestamp  DateTime @default(now())
  reviewed   Boolean  @default(false)
  severity   String
  resolution String?
  
  @@map("securityIncidents")
}

// نماذج نظام التوصيات المتقدم

model CustomerBehavior {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId            String   @unique @db.ObjectId
  customer              Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  // تحليل السلوك العام
  totalSessions         Int      @default(0)
  totalTimeSpent        Int      @default(0) // بالثواني
  averageSessionTime    Float    @default(0)
  
  // تحليل البحث
  totalSearches         Int      @default(0)
  topSearchTerms        String[] // أكثر مصطلحات البحث
  searchCategories      Json     @default("{}") // فئات البحث مع التكرار
  
  // تحليل المنتجات
  viewedProductsCount   Int      @default(0)
  purchasedProductsCount Int     @default(0)
  favoriteCategories    Json     @default("{}") // الفئات المفضلة مع النقاط
  favoriteBrands        Json     @default("{}") // العلامات التجارية المفضلة
  priceRange           Json     @default("{}") // نطاق الأسعار المفضل
  
  // تحليل الوقت
  preferredShoppingTimes Json    @default("{}") // أوقات التسوق المفضلة
  seasonalPreferences   Json     @default("{}") // التفضيلات الموسمية
  
  // نقاط الاهتمام
  interestScore         Float    @default(0)   // نقاط الاهتمام العامة
  loyaltyScore          Float    @default(0)   // نقاط الولاء
  engagementScore       Float    @default(0)   // نقاط التفاعل
  
  lastUpdated           DateTime @default(now())
  createdAt             DateTime @default(now())
  
  @@map("customer_behaviors")
}

model SearchHistory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId  String   @db.ObjectId
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  searchTerm  String
  category    String?
  resultsCount Int     @default(0)
  clickedResults String[] // IDs المنتجات التي تم النقر عليها
  sessionId   String?
  source      String   @default("search_bar") // search_bar, voice, suggestions
  
  searchedAt  DateTime @default(now())
  
  @@map("search_histories")
}

model ProductInteraction {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId    String   @db.ObjectId
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId     String   @db.ObjectId
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  interactionType String // view, add_to_cart, remove_from_cart, purchase, wishlist, share
  value         Float?   // للشراء: السعر، للمشاهدة: المدة بالثواني
  context       Json?    // معلومات إضافية حسب نوع التفاعل
  sessionId     String?
  source        String?  // search, recommendation, category, etc.
  
  createdAt     DateTime @default(now())
  
  @@map("product_interactions")
}

model CustomerPreferenceProfile {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId        String   @unique @db.ObjectId
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  // الملف الشخصي للتفضيلات
  preferredCategories Json   @default("{}") // مع أوزان
  preferredBrands     Json   @default("{}") // مع أوزان
  preferredPriceRange Json   @default("{}")
  preferredColors     Json   @default("{}") // مع أوزان
  
  // نمط التسوق
  shoppingPersonality String? // explorer, bargain_hunter, brand_loyal, trendy, practical
  decisionSpeed       String? // fast, moderate, slow
  priceSenesitivity   String? // high, medium, low
  
  // تفضيلات التوصيات
  recommendationTypes Json   @default("{}") // نوع التوصيات المفضلة
  
  // الثقة والجودة
  trustFactors        Json   @default("{}") // reviews, ratings, brands
  
  updatedAt           DateTime @default(now())
  createdAt           DateTime @default(now())
  
  @@map("customer_preference_profiles")
}

model RecommendationHistory {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId    String   @db.ObjectId
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  recommendationType String // similar_products, trending, personalized, category_based
  recommendedItems   Json   // قائمة المنتجات المقترحة
  context           Json   // السياق الذي أدى للتوصية
  
  // مقاييس الأداء
  shown           Boolean @default(false)
  clicked         String[] // IDs المنتجات التي تم النقر عليها
  purchased       String[] // IDs المنتجات التي تم شراؤها
  dismissed       Boolean @default(false)
  
  effectiveness   Float?  // فعالية التوصية (0-1)
  
  createdAt       DateTime @default(now())
  
  @@map("recommendation_histories")
}

model CustomerSegment {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId    String   @db.ObjectId
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  segmentType   String   // vip, frequent_buyer, price_sensitive, new_customer, etc.
  segmentScore  Float    @default(0)
  segmentData   Json     @default("{}")
  
  assignedAt    DateTime @default(now())
  lastUpdated   DateTime @default(now())
  
  @@map("customer_segments")
}

// Enums
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderSource {
  WEBSITE
  WHATSAPP
  PHONE
  INSTAGRAM
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CREDIT_CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum NotificationType {
  ORDER_UPDATE
  PROMOTION
  SYSTEM
  CUSTOM
}

enum VoteAction {
  HELPFUL
  NOT_HELPFUL
}





// Gift Boxes
model Box {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  price       Float
  image       String?
  color       String? // لون الصندوق
  size        String? // حجم الصندوق (صغير، متوسط، كبير)
  material    String? // مادة الصندوق (كرتون، خشب، بلاستيك)
  stock       Int    @default(0)
  dimensions  String? // أبعاد الصندوق (مثل: "20x15x10 سم")
  // إضافة أبعاد مفصلة للصندوق
  width       Float?   // العرض الداخلي (سم)
  height      Float?   // الارتفاع الداخلي (سم)
  depth       Float?   // العمق الداخلي (سم)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  inspirationBoxes InspirationBoxRelation[]
  
  @@map("boxes")
}

// Gift Bags
model Bag {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  price       Float
  image       String?
  color       String? // لون الكيس
  size        String? // حجم الكيس (صغير، متوسط، كبير)
  material    String? // مادة الكيس (ورق، قماش، بلاستيك)
  stock       Int    @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  inspirationBags InspirationBagRelation[]
  
  @@map("bags")
}


// Sweets - نموذج مبسط للحلويات
model Sweet {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   // اسم الحلوى (مثل: "شوكولاتة كيت كات", "حلوى هاريبو")
  description String?  // وصف الحلوى
  price       Float    // السعر الحالي
  old_price   Float?   // السعر القديم (للخصومات)
  category    String   // "شوكولاتة" أو "كاندي" أو "شيبس"
  image       String?  // صورة الحلوى
  stock       Int      @default(0) // الكمية المتاحة
  // إضافة الأبعاد ثلاثية الأبعاد للحلويات
  width       Float?   // العرض (سم)
  height      Float?   // الارتفاع (سم)
  depth       Float?   // العمق (سم)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  inspirationSweets InspirationSweet[]
  
  @@map("sweets")
}

// ربط الإلهام بالحلويات
model InspirationSweet {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  inspirationId String  @db.ObjectId
  inspiration   Inspiration @relation(fields: [inspirationId], references: [id], onDelete: Cascade)
  sweetId      String   @db.ObjectId
  sweet        Sweet    @relation(fields: [sweetId], references: [id], onDelete: Cascade)
  quantity     Int      @default(1)
  
  @@unique([inspirationId, sweetId])
}

// ربط الإلهام بالمنتجات الأساسية (سيحل محل InspirationMainProduct)
model InspirationProduct {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  inspirationId String  @db.ObjectId
  inspiration   Inspiration @relation("InspirationProducts", fields: [inspirationId], references: [id], onDelete: Cascade)
  productId    String   @db.ObjectId
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity     Int      @default(1)
  
  @@unique([inspirationId, productId])
}

// ربط الإلهام بالصناديق (سيحل محل InspirationBox الحالي)
model InspirationBoxRelation {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  inspirationId String  @unique @db.ObjectId
  inspiration   Inspiration @relation("InspirationBoxes", fields: [inspirationId], references: [id], onDelete: Cascade)
  boxId        String   @db.ObjectId
  box          Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)
}

// ربط الإلهام بالشنط (سيحل محل InspirationBag الحالي)
model InspirationBagRelation {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  inspirationId String  @unique @db.ObjectId
  inspiration   Inspiration @relation("InspirationBags", fields: [inspirationId], references: [id], onDelete: Cascade)
  bagId        String   @db.ObjectId
  bag          Bag      @relation(fields: [bagId], references: [id], onDelete: Cascade)
}

